@page "/"
@attribute [Authorize]
@inject IJSRuntime JS
<PageTitle>StockFlow · Operations workspace</PageTitle>
<div class="shell">
<aside><a class="brand" href="/"><span class="brand-icon">▦</span> StockFlow<span class="brand-dot">.</span></a><div class="workspace"><span class="workspace-avatar">M</span><div>Maison & Co.<small>Operations workspace</small></div><span>⌄</span></div><p class="nav-label">WORKSPACE</p><nav>@foreach(var tab in tabs){<button class="nav-item @(view==tab?"selected":"")" @onclick="()=>ChangeView(tab)"><span>@Icon(tab)</span>@tab @if(tab=="Inventory" && low.Count>0){<b>@low.Count</b>}</button>}</nav><div class="sidebar-bottom"><div class="system-status"><i></i> All systems operational</div><div class="profile"><span class="workspace-avatar">@((role=="Admin")?"AD":"ST")</span><div>@role<small>@email</small></div><button title="Sign out" @onclick="Logout">↪</button></div></div></aside>
<main><header class="topbar"><div>Workspace <span>/</span> <strong>@view</strong></div><div class="topbar-right"><span class="live-dot"></span> Live workspace <span class="divider">|</span> @DateTime.UtcNow.ToString("ddd, dd MMM yyyy")</div></header><div class="content"><div class="page-heading"><div><p class="eyebrow">YOUR BUSINESS AT A GLANCE</p><h1>@(view=="Overview"?"Let’s keep things moving.":view)</h1><p>@Subtitle</p></div><div class="heading-actions"><button class="secondary" disabled="@busy" @onclick="Refresh">↻ Refresh</button><button @onclick='()=>Open("order")'>＋ Create order</button></div></div>
@if(error!=""){<div class="notice error" role="alert">@error <button @onclick='()=>error=""'>×</button></div>}
@if(success!=""){<div class="notice success" role="status">@success <button @onclick='()=>success=""'>×</button></div>}
@if(!loaded){<div class="panel empty">Loading your workspace…</div>}
else if(view=="Overview"){
<div class="stats"><div class="stat"><div>Realised sales <span>↗</span></div><strong>@Money(sales.Sum(x=>x.Revenue))</strong><small>From shipped orders · all time</small></div><div class="stat"><div>Total orders <span>▤</span></div><strong>@metrics.TotalOrders</strong><small>Across all order statuses</small></div><div class="stat"><div>Active products <span>▦</span></div><strong>@metrics.ActiveProducts<em>in your catalogue</em></strong><small>@metrics.AvailableUnits units available</small></div><div class="stat"><div>Low-stock alerts <span class="amber">⚑</span></div><strong>@low.Count<em class="amber">need attention</em></strong><small>At or below reorder level</small></div></div>
<div class="overview-grid"><section class="panel"><div class="panel-heading"><div><h2>Sales performance</h2><p>Shipped revenue by month</p></div><span class="tag">GBP · All time</span></div><div class="chart">@if(sales.Count==0){<p>No shipped sales yet. Ship an order to see revenue here.</p>}else{var max=sales.Max(x=>x.Revenue);@foreach(var row in sales.OrderBy(x=>x.Month).TakeLast(8)){<div class="chart-col"><span>@Money(row.Revenue)</span><div class="bar" style="height:@(max==0?0:Math.Max(3,row.Revenue/max*150))px"></div><small>@row.Month</small></div>}}</div><div class="chart-footer"><span class="legend-dot"></span> Shipped orders <span>Updated from your live database</span></div></section><section class="panel"><div class="panel-heading"><div><h2>Stock watch</h2><p>A little attention goes a long way</p></div><span class="count-badge">@low.Count</span></div>@foreach(var p in low.Take(4)){<div class="stock-watch"><span class="product-icon @Color(p.Id)">▧</span><div><strong>@p.Name</strong><small>@p.Sku</small></div><span class="stock-count">@p.Available left<small>Min. @p.ReorderLevel</small></span></div>}@if(low.Count==0){<div class="empty">Everything is well stocked.</div>}<button class="text-button full" @onclick='()=>ChangeView("Inventory")'>View inventory <span>→</span></button></section></div>
<section class="panel"><div class="panel-heading"><div><h2>Recent orders</h2><p>The latest activity across your store</p></div><button class="text-button" @onclick='()=>ChangeView("Orders")'>View all orders →</button></div>@OrderTable(orders.Take(6))</section>
<div class="bottom-note"><span>◈</span> A clear view. A smoother day. <small>StockFlow keeps your orders and inventory in sync.</small></div>
}
else if(view=="Inventory"){
<div class="toolbar"><input aria-label="Search products" placeholder="Search name, SKU or category…" @bind="search" @bind:event="oninput" /><label class="inline"><input type="checkbox" @bind="onlyLow" @bind:after="SearchProducts" /> Low stock only</label><button class="secondary" @onclick="SearchProducts">Search</button><AuthorizeView Roles="Admin"><button @onclick='()=>Open("product")'>＋ Add product</button></AuthorizeView></div>
<section class="panel"><div class="table-scroll"><table><thead><tr><th>PRODUCT</th><th>CATEGORY</th><th>PRICE</th><th>ON HAND</th><th>RESERVED</th><th>AVAILABLE</th><th></th></tr></thead><tbody>@foreach(var p in FilteredProducts){<tr><td><div class="product-cell"><span class="product-icon @Color(p.Id)">▧</span><div><strong>@p.Name @if(!p.Active){<small>Archived</small>}</strong><small>@p.Sku</small></div></div></td><td>@p.Category</td><td>@Money(p.Price)</td><td>@p.OnHand</td><td>@p.Reserved</td><td><span class="badge @(p.Available<=p.ReorderLevel?"low":"shipped")">@p.Available units</span></td><td><div class="row-actions">@if(p.Active){<button class="secondary small" @onclick='()=>Open("receive",p.Id)'>Receive stock</button>}<AuthorizeView Roles="Admin"><button class="secondary small" @onclick="()=>EditProduct(p)">Edit</button>@if(p.Active){<button class="secondary small" @onclick='()=>Open("archive",p.Id)'>Archive</button>}</AuthorizeView></div></td></tr>}</tbody></table></div>@if(!FilteredProducts.Any()){<div class="empty">No products match your filters.</div>}</section><div class="pagination"><span>@inventoryTotal products / Page @productPage</span><button class="secondary" disabled="@(productPage<=1)" @onclick="ProductPrevious">Previous</button><button class="secondary" disabled="@(productPage*20>=inventoryTotal)" @onclick="ProductNext">Next</button></div>
}
else if(view=="Orders"){
<div class="toolbar"><input aria-label="Search orders" placeholder="Search customer…" @bind="search" @bind:event="oninput" /><select aria-label="Order status" @bind="status" @bind:after="LoadOrders"><option value="">All statuses</option><option>Draft</option><option>Confirmed</option><option>Shipped</option><option>Cancelled</option></select><button class="secondary" @onclick="LoadOrders">Search</button></div><section class="panel">@OrderTable(orders)</section><div class="pagination"><span>@orderTotal orders · Page @orderPage</span><button class="secondary" disabled="@(orderPage<=1)" @onclick="Previous">← Previous</button><button class="secondary" disabled="@(orderPage*20>=orderTotal)" @onclick="Next">Next →</button></div>
}
else if(view=="Customers"){
<div class="toolbar"><input aria-label="Search customers" placeholder="Search customers…" @bind="search" @bind:event="oninput" /><button class="secondary" @onclick="SearchCustomers">Search</button><button @onclick='()=>Open("customer")'>＋ Add customer</button></div><section class="panel"><table><thead><tr><th>CUSTOMER</th><th>EMAIL</th><th>ADDRESS</th><th></th></tr></thead><tbody>@foreach(var c in customerItems){<tr><td><strong>@c.Name</strong></td><td>@c.Email</td><td>@c.Address</td><td><button class="secondary small" @onclick="()=>EditCustomer(c)">Edit</button></td></tr>}</tbody></table></section><div class="pagination"><span>@customerListTotal customers / Page @customerPage</span><button class="secondary" disabled="@(customerPage<=1)" @onclick="CustomerPrevious">Previous</button><button class="secondary" disabled="@(customerPage*20>=customerListTotal)" @onclick="CustomerNext">Next</button></div>
}
else if(view=="Reports"){
<div class="overview-grid"><section class="panel"><div class="panel-heading"><div><h2>Sales by month</h2><p>Recognised on shipment · GBP</p></div></div><table><thead><tr><th>MONTH</th><th>ORDERS</th><th>REVENUE</th><th>CUMULATIVE</th></tr></thead><tbody>@foreach(var r in sales.OrderBy(x=>x.Month)){<tr><td>@r.Month</td><td>@r.Orders</td><td>@Money(r.Revenue)</td><td>@Money(r.RunningRevenue)</td></tr>}</tbody></table></section><section class="panel"><div class="panel-heading"><div><h2>Best-selling products</h2><p>Ranked by shipped revenue</p></div></div><table><thead><tr><th>RANK</th><th>PRODUCT</th><th>UNITS</th><th>REVENUE</th></tr></thead><tbody>@foreach(var r in top.OrderBy(x=>x.Rank)){<tr><td>#@r.Rank</td><td>@r.Name</td><td>@r.Units</td><td>@Money(r.Revenue)</td></tr>}</tbody></table></section></div>
}
else if(view=="Activity"){
<AuthorizeView Roles="Admin"><Authorized><section class="panel"><div class="panel-heading"><div><h2>Audit history</h2><p>Latest 50 recorded operations · UTC</p></div></div><table><thead><tr><th>TIME</th><th>ACTOR</th><th>ACTION</th><th>DETAIL</th></tr></thead><tbody>@foreach(var a in audit){<tr><td>@a.At.ToString("dd MMM HH:mm:ss")</td><td>@a.Actor</td><td>@a.Action</td><td>@a.Detail</td></tr>}</tbody></table></section></Authorized><NotAuthorized><div class="panel empty">Audit history is available to administrators.</div></NotAuthorized></AuthorizeView>
}
</div></main></div>
@if(modal!=""){
<div class="modal-backdrop"><section class="modal" role="dialog" aria-modal="true" aria-labelledby="modal-title"><div class="panel-heading"><h2 id="modal-title">@ModalTitle</h2><button class="close" disabled="@busy" @onclick='()=>modal=""' aria-label="Close">×</button></div><form @onsubmit="Save" @onsubmit:preventDefault><div class="modal-body">
@if(formError!=""){<div class="notice error" role="alert">@formError</div>}
@if(modal=="order"){
<label>Customer<select @bind="customerId" required><option value="0">Choose a customer</option>@foreach(var c in customers){<option value="@c.Id">@c.Name</option>}</select></label><p class="muted">Drafts do not reserve stock. Confirm the order when you are ready. Selectors show the first 100 customers and products.</p>
@foreach(var line in draftLines){<div class="line-input"><select aria-label="Product" @bind="line.ProductId"><option value="0">Choose a product</option>@foreach(var p in products.Where(x=>x.Active)){<option value="@p.Id">@p.Name · @Money(p.Price) · @p.Available available</option>}</select><input aria-label="Quantity" type="number" min="1" max="100000" @bind="line.Quantity" /><button type="button" class="secondary" aria-label="Remove line" @onclick="()=>draftLines.Remove(line)">×</button></div>}
<button type="button" class="secondary" @onclick="()=>draftLines.Add(new())">＋ Add line</button><div class="order-total">Order total <strong>@Money(draftLines.Sum(l=>(products.FirstOrDefault(p=>p.Id==l.ProductId)?.Price??0)*l.Quantity))</strong></div>
}else if(modal=="product"){
<label>Product name<input required maxlength="160" @bind="name" /></label><div class="form-grid"><label>SKU<input required maxlength="40" @bind="sku" /></label><label>Category<input maxlength="80" @bind="category" /></label><label>Unit price (£)<input type="number" min="0" max="1000000" step="0.01" @bind="price" /></label><label>Reorder level<input type="number" min="0" max="100000" @bind="reorder" /></label></div><p class="muted">Receive stock separately to keep a record of every stock movement.</p>
}else if(modal=="customer"){
<label>Full name<input required maxlength="160" @bind="name" /></label><label>Email<input required type="email" maxlength="254" @bind="customerEmail" /></label><label>Delivery address<textarea maxlength="300" @bind="address"></textarea></label>
}else if(modal=="receive"){
<p>Receive inventory for <strong>@products.Concat(inventoryItems).FirstOrDefault(x=>x.Id==selectedId)?.Name</strong>.</p><label>Quantity<input type="number" min="1" max="100000" @bind="quantity" required /></label><label>Receipt / delivery reference<input maxlength="120" required @bind="reference" placeholder="e.g. PO-2026-1042" /></label>
}else if(modal=="archive"){
<p>Archive <strong>@products.Concat(inventoryItems).FirstOrDefault(x=>x.Id==selectedId)?.Name</strong>? Existing confirmed orders can still be shipped or cancelled. New orders and stock receipts will be disabled for this product.</p>
}else if(modal=="detail"){
@if(detail is not null){<p><strong>Order #@detail.Id.ToString("D4")</strong> · @detail.Customer.Name</p><p>@detail.Customer.Email<br />@detail.Customer.Address</p><span class="badge @detail.Status.ToLower()">@detail.Status</span><table><thead><tr><th>ITEM</th><th>QTY</th><th>UNIT PRICE</th></tr></thead><tbody>@foreach(var l in detail.Lines){<tr><td>@l.Product.Name</td><td>@l.Quantity</td><td>@Money(l.UnitPrice)</td></tr>}</tbody></table><div class="order-total">Total<strong>@Money(detail.Total)</strong></div><div class="row-actions">@if(detail.Status=="Draft"){<button type="button" disabled="@busy" @onclick='()=>Act(detail.Id,"confirm")'>Confirm & reserve</button>}@if(detail.Status=="Confirmed"){<button type="button" disabled="@busy" @onclick='()=>Act(detail.Id,"ship")'>Mark shipped</button>}@if(detail.Status is "Draft" or "Confirmed"){<button type="button" class="danger" disabled="@busy" @onclick='()=>Act(detail.Id,"cancel")'>Cancel order</button>}</div>}
}
</div>@if(modal!="detail"){<footer class="modal-footer"><button type="button" class="secondary" disabled="@busy" @onclick='()=>modal=""'>Cancel</button><button disabled="@busy" type="submit">@(busy?"Saving…":modal=="order"?"Create draft order":modal=="receive"?"Receive stock":modal=="archive"?"Archive product":"Save changes")</button></footer>}</form></section></div>
}
@code {
 string view="Overview",search="",status="",error="",success="",modal="",formError="",email="",role="",name="",sku="",category="",customerEmail="",address="",reference="";
 bool loaded,busy,onlyLow;int selectedId,customerId,quantity=1,reorder=5,orderPage=1,orderTotal,productTotal,customerTotal;decimal price;
 string[] tabs=["Overview","Orders","Inventory","Customers","Reports","Activity"];
 int productPage=1,customerPage=1,inventoryTotal,customerListTotal;
 List<Product> inventoryItems=[];List<Customer> customerItems=[];
 List<Product> products=[];List<Customer> customers=[];List<Order> orders=[];List<Product> low=[];List<SalesRow> sales=[];List<TopProductRow> top=[];List<AuditEvent> audit=[];List<DraftLine> draftLines=[];Order? detail;
 class DraftLine {public int ProductId{get;set;} public int Quantity{get;set;}=1;}
 record Me(string Email,string Role);
 record Metrics(int ActiveProducts,long AvailableUnits,int TotalOrders);
 Metrics metrics=new(0,0,0);
 IEnumerable<Product> FilteredProducts=>inventoryItems;
 string Subtitle=>view switch{"Overview"=>"Here’s what’s happening with your orders and inventory today.","Orders"=>"From first draft to front door. Every order, in one place.","Inventory"=>"Know what’s on your shelves and what’s ready to sell.","Customers"=>"The people behind every order.","Reports"=>"A closer look at what’s moving your business forward.",_=>"A clear record of changes across your workspace."};
 string ModalTitle=>modal switch{"order"=>"Create a new order","product"=>selectedId==0?"Add a product":"Edit product","customer"=>selectedId==0?"Add a customer":"Edit customer","receive"=>"Receive stock","archive"=>"Archive product",_=>"Order details"};
 static string Icon(string t)=>t switch{"Overview"=>"◫","Orders"=>"▤","Inventory"=>"▦","Customers"=>"♧","Reports"=>"▥",_=>"◷"};
 static string Color(int id)=>new[]{"peach","sage","lilac","sand"}[id%4];
 static string Money(decimal value)=>value.ToString("C",System.Globalization.CultureInfo.GetCultureInfo("en-GB"));
 async Task<T> Get<T>(string path)=>await JS.InvokeAsync<T>("sf.request","GET",path,null);
 async Task Send(string method,string path,object? body=null)=>await JS.InvokeVoidAsync("sf.request",method,path,body);
 protected override async Task OnAfterRenderAsync(bool first){if(first){await Refresh();StateHasChanged();}}
 async Task Refresh(){try{busy=true;error="";var me=await Get<Me>("/auth/me");email=me.Email;role=me.Role;metrics=await Get<Metrics>("/dashboard");var p=await Get<PageResult<Product>>("/products?pageSize=100");products=p.Items;productTotal=p.Total;var c=await Get<PageResult<Customer>>("/customers?pageSize=100");customers=c.Items;customerTotal=c.Total;await LoadOrders();await LoadProducts();await LoadCustomers();low=await Get<List<Product>>("/reports/low-stock");sales=await Get<List<SalesRow>>("/reports/sales");top=await Get<List<TopProductRow>>("/reports/top-products");if(role=="Admin")audit=await Get<List<AuditEvent>>("/audit");loaded=true;}catch(Exception ex){error=Clean(ex);}finally{busy=false;}}
 async Task LoadOrders(){try{var p=await Get<PageResult<Order>>($"/orders?page={orderPage}&status={Uri.EscapeDataString(status)}&search={Uri.EscapeDataString(view=="Orders"?search:"")}");orders=p.Items;orderTotal=p.Total;}catch(Exception ex){error=Clean(ex);}}
 async Task ChangeView(string v){view=v;search="";status="";orderPage=productPage=customerPage=1;await LoadOrders();await LoadProducts();await LoadCustomers();}
 async Task LoadProducts(){try{var p=await Get<PageResult<Product>>($"/products?page={productPage}&pageSize=20&search={Uri.EscapeDataString(view=="Inventory"?search:"")}&lowStock={onlyLow.ToString().ToLower()}");inventoryItems=p.Items;inventoryTotal=p.Total;}catch(Exception ex){error=Clean(ex);}}
 async Task LoadCustomers(){try{var p=await Get<PageResult<Customer>>($"/customers?page={customerPage}&pageSize=20&search={Uri.EscapeDataString(view=="Customers"?search:"")}");customerItems=p.Items;customerListTotal=p.Total;}catch(Exception ex){error=Clean(ex);}}
 async Task SearchProducts(){productPage=1;await LoadProducts();}async Task SearchCustomers(){customerPage=1;await LoadCustomers();}
 async Task ProductNext(){productPage++;await LoadProducts();}async Task ProductPrevious(){productPage--;await LoadProducts();}
 async Task CustomerNext(){customerPage++;await LoadCustomers();}async Task CustomerPrevious(){customerPage--;await LoadCustomers();}
 async Task Next(){orderPage++;await LoadOrders();}async Task Previous(){orderPage--;await LoadOrders();}
 void Open(string type,int id=0){modal=type;selectedId=id;formError="";name=sku=category=customerEmail=address=reference="";price=0;reorder=5;quantity=1;customerId=0;draftLines=[new()];}
 void EditProduct(Product p){Open("product",p.Id);name=p.Name;sku=p.Sku;category=p.Category;price=p.Price;reorder=p.ReorderLevel;}
 void EditCustomer(Customer c){Open("customer",c.Id);name=c.Name;customerEmail=c.Email;address=c.Address;}
 async Task ShowOrder(int id){try{detail=await Get<Order>($"/orders/{id}");modal="detail";formError="";}catch(Exception ex){error=Clean(ex);}}
 async Task Save(){if(busy)return;busy=true;formError="";try{
 switch(modal){case "product":await Send(selectedId==0?"POST":"PUT",selectedId==0?"/products":$"/products/{selectedId}",new ProductInput(sku,name,category,price,reorder));break;
 case "customer":await Send(selectedId==0?"POST":"PUT",selectedId==0?"/customers":$"/customers/{selectedId}",new CustomerInput(name,customerEmail,address));break;
 case "order":await Send("POST","/orders",new OrderInput(customerId,draftLines.Select(x=>new LineInput(x.ProductId,x.Quantity)).ToList()));break;
 case "receive":await Send("POST",$"/products/{selectedId}/receive",new ReceiptInput(quantity,reference));break;
 case "archive":await Send("DELETE",$"/products/{selectedId}");break;}
 modal="";success="Changes saved. Your workspace is up to date.";await Refresh();}catch(Exception ex){formError=Clean(ex);}finally{busy=false;}}
 async Task Act(int id,string action){if(busy)return;busy=true;formError="";try{await Send("POST",$"/orders/{id}/{action}");modal="";success=$"Order #{id:D4} updated successfully.";await Refresh();}catch(Exception ex){formError=Clean(ex);}finally{busy=false;}}
 async Task Logout()=>await JS.InvokeVoidAsync("sf.logout");
 static string Clean(Exception e)=>e.Message.Split('\n')[0];
 RenderFragment OrderTable(IEnumerable<Order> items)=>@<div class="table-scroll"><table><thead><tr><th>ORDER</th><th>CUSTOMER</th><th>DATE</th><th>STATUS</th><th>ITEMS</th><th>TOTAL</th><th></th></tr></thead><tbody>@foreach(var o in items){<tr><td><button class="order-link" @onclick="()=>ShowOrder(o.Id)">#SF-@o.Id.ToString("D4")</button></td><td><div class="customer-cell"><span class="avatar @Color(o.CustomerId)">@o.Customer.Name[..1]</span><div><strong>@o.Customer.Name</strong><small>@o.Customer.Email</small></div></div></td><td>@o.CreatedAt.ToString("dd MMM, yyyy")</td><td><span class="badge @o.Status.ToLower()"><i></i>@o.Status</span></td><td>@o.Lines.Sum(x=>x.Quantity)</td><td class="amount">@Money(o.Total)</td><td><button class="open-order" title="View order" @onclick="()=>ShowOrder(o.Id)">↗</button></td></tr>}</tbody></table>@if(!items.Any()){<div class="empty">No orders found. Create an order to get started.</div>}</div>;
}
