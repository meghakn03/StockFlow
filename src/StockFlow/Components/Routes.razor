@using Microsoft.AspNetCore.Components.Routing
<Router AppAssembly="typeof(Program).Assembly"><Found Context="routeData"><AuthorizeRouteView RouteData="routeData"><NotAuthorized><p>Please <a href="/login">sign in</a> to continue.</p></NotAuthorized></AuthorizeRouteView><FocusOnNavigate RouteData="routeData" Selector="h1" /></Found><NotFound><h1>Page not found</h1><a href="/">Return to workspace</a></NotFound></Router>
